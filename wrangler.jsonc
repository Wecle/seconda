{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seconda",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bf4f5844ed81458fa4b2099850eef4b3",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/seconda_placeholder"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
