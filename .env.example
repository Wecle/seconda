# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/seconda
# Direct AI providers. Primary/fallback models within a tier must share a prefix.
# Fast tier: Real-time interactive agent turns, interview opening questions, and context compaction
FAST_MODEL_API_KEY=your-fast-tier-provider-key
# Quality tier: Resume parsing, resume generation, 6-dimension question scoring, and comprehensive report generation
QUALITY_MODEL_API_KEY=your-quality-tier-provider-key
AI_MODEL_FAST=deepseek/deepseek-v4-flash
AI_MODEL_FAST_FALLBACK=deepseek/deepseek-v4-pro
AI_MODEL_QUALITY=zhipu/glm-5.1
AI_MODEL_QUALITY_FALLBACK=zhipu/glm-4.7
AGENT_MODEL_CONTEXT_WINDOWS_JSON={"deepseek/deepseek-v4-flash":1048576,"deepseek/deepseek-v4-pro":1048576,"zhipu/glm-5.1":128000,"zhipu/glm-4.7":128000}
AGENT_MODEL_CONTEXT_BUDGETS_JSON={"deepseek/deepseek-v4-flash":128000,"deepseek/deepseek-v4-pro":128000,"zhipu/glm-5.1":128000,"zhipu/glm-4.7":128000}
# Optional provider proxy/self-hosted endpoints. HTTPS is required except localhost.
AI_PROVIDER_BASE_URLS_JSON={}
AI_APPROVED_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,zhipu/glm-5.1,zhipu/glm-4.7

# AI observability and resource protection
AI_BUDGET_MODE=observe
AI_TASK_TOKEN_LIMIT=500000
# Prices are integer micros per one million tokens. Omit to report unknown cost.
AI_MODEL_PRICING_JSON={"version":1,"models":{}}

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GITHUB_ID=github-oauth-client-id
AUTH_GITHUB_SECRET=github-oauth-client-secret
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret

# Vercel Blob
BLOB_READ_WRITE_TOKEN=xxx
